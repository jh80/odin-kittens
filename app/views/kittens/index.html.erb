<h1>Kittens!</h1>
<% if @kittens.empty? %>
    <p>No kittens yet!</p>
<% else %>
    <ul>
        <% @kittens.each do |kitten| %>
            <li class="kitten_info">
                <%= kitten.name  %>
                <%= button_to "Delete #{kitten.name}", kitten, method: :delete, data: {turbo_confirm: "Are you sure?"} %>
            </li>
        <% end %>
    </ul>
<% end %>