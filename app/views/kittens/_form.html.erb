<%= form_with model: kitten do |form| %>
    <div class="form_input">
        <%= form.label :name %>
        <%= form.text_field :name %>
    </div>

    <div class="form_input">
        <%= form.label :age %>
        <%= form.number_field :age, min: 0, max: 12 %>
    </div>

    <div class="form_input">
        <%= form.label :cuteness %>
        <%= form.number_field :cuteness, min: 0, max: 10 %>
    </div>

    <div class="form_input">
        <%= form.label :softness %>
        <%= form.number_field :softness, min: 0, max: 10 %>
    </div>

    <div><%= form.submit %></div>

<% end %>